{
  "name": "spill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "ai",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && npm run test --workspaces --if-present",
    "dev:reader": "npm run dev -w @spill/reader-web",
    "dev:admin": "npm run dev -w @spill/admin-web",
    "dev:api": "npm run dev -w @spill/api",
    "start:api": "npm run start -w @spill/api",
    "backup:mongodb": "node scripts/backup-mongodb.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
