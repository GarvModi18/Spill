# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
READER_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
API_URL=http://localhost:4000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/spill

# Redis / BullMQ
REDIS_URL=redis://localhost:6379

# Authentication — configure according to the selected auth implementation
AUTH_SECRET=replace-with-a-long-random-secret
UNSUBSCRIBE_SECRET=replace-with-another-long-random-secret

# Optional one-time bootstrap for the first administrator account.
# Set these only during the explicit bootstrap command, then remove them.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Groq — required to enable Tea Concierge responses; keep server-side only
GROQ_API_KEY=
# Set the model ID enabled for your Groq account.
GROQ_MODEL=

# Research providers
TAVILY_API_KEY=
GITHUB_TOKEN=

# Email provider
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=

# Optional observability
SENTRY_DSN=
LOG_LEVEL=info

# API
PORT=4000
